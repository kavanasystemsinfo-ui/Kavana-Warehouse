# =============================================================================
# KAVANA WAREHOUSE — Environment Variables
# Copy this file to .env and customize for your environment
# =============================================================================

# Database
DATABASE_URL="postgresql://kavana:***@db:5432/kavana_warehouse"

# JWT
JWT_SECRET=tu-sec...tock <kavanasystems.info@gmail.com>

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN="https://warehouse.kavanasystems.com,http://localhost:4001,http://localhost:4000"

# Push notifications (opcional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sesión
JWT_EXPIRES_IN=2h              # vida del access token
REFRESH_TOKEN_DAYS=7           # vida del refresh token (rotativo, se guarda hasheado)
LOGIN_MAX_FALLOS=10            # intentos fallidos por IP+usuario en 15 min antes de bloquear

# Alta pública de empresas: cerrada en producción salvo que se active aquí
REGISTRO_PUBLICO=false
